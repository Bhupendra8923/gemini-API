<!doctype html>
<html lang="en">
  <head>
    <title>Gemini AI Chat Panel</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Segoe UI', sans-serif;
        background: #0f0f0f;
        color: #e0e0e0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      /* ── API Key Screen ── */
      #key-screen {
        background: #1a1a1a;
        border: 1px solid #333;
        border-radius: 16px;
        padding: 40px;
        width: 380px;
        text-align: center;
        box-shadow: 0 8px 32px rgba(0,0,0,0.5);
      }

      #key-screen h2 {
        font-size: 22px;
        margin-bottom: 8px;
        color: #fff;
      }

      #key-screen p {
        font-size: 13px;
        color: #888;
        margin-bottom: 24px;
        line-height: 1.5;
      }

      #key-screen input {
        width: 100%;
        padding: 12px 16px;
        border-radius: 10px;
        border: 1px solid #444;
        background: #111;
        color: #fff;
        font-size: 14px;
        margin-bottom: 12px;
        outline: none;
      }

      #key-screen input:focus { border-color: #4f8ef7; }

      #key-screen button {
        width: 100%;
        padding: 12px;
        border-radius: 10px;
        border: none;
        background: #4f8ef7;
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }

      #key-screen button:hover { background: #3a7de0; }

      #key-error {
        color: #ff5c5c;
        font-size: 13px;
        margin-top: 10px;
        display: none;
      }

      /* ── Chat Screen ── */
      #chat-screen {
        display: none;
        flex-direction: column;
        width: 100%;
        max-width: 700px;
        height: 100vh;
        padding: 20px;
      }

      #chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
      }

      #chat-header h2 {
        font-size: 20px;
        color: #fff;
      }

      #reset-key-btn {
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 8px;
        border: 1px solid #444;
        background: transparent;
        color: #888;
        cursor: pointer;
        transition: all 0.2s;
      }

      #reset-key-btn:hover { border-color: #ff5c5c; color: #ff5c5c; }

      #chat {
        flex: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding-right: 4px;
      }

      #chat::-webkit-scrollbar { width: 4px; }
      #chat::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }

      .bubble {
        max-width: 80%;
        padding: 12px 16px;
        border-radius: 16px;
        font-size: 14px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .bubble.user {
        align-self: flex-end;
        background: #4f8ef7;
        color: #fff;
        border-bottom-right-radius: 4px;
      }

      .bubble.ai {
        align-self: flex-start;
        background: #1e1e1e;
        color: #ddd;
        border: 1px solid #2a2a2a;
        border-bottom-left-radius: 4px;
      }

      .bubble.error { background: #2a1010; color: #ff5c5c; border-color: #3a1010; }

      .typing {
        align-self: flex-start;
        background: #1e1e1e;
        border: 1px solid #2a2a2a;
        border-radius: 16px;
        border-bottom-left-radius: 4px;
        padding: 14px 18px;
        display: flex;
        gap: 5px;
        align-items: center;
      }

      .typing span {
        width: 7px; height: 7px;
        background: #555;
        border-radius: 50%;
        animation: blink 1.2s infinite;
      }

      .typing span:nth-child(2) { animation-delay: 0.2s; }
      .typing span:nth-child(3) { animation-delay: 0.4s; }

      @keyframes blink {
        0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
        40% { opacity: 1; transform: scale(1); }
      }

      #input-area {
        display: flex;
        gap: 10px;
        margin-top: 16px;
      }

      #msg {
        flex: 1;
        padding: 13px 16px;
        border-radius: 12px;
        border: 1px solid #333;
        background: #1a1a1a;
        color: #fff;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
      }

      #msg:focus { border-color: #4f8ef7; }

      #send-btn {
        padding: 13px 22px;
        border-radius: 12px;
        border: none;
        background: #4f8ef7;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }

      #send-btn:hover { background: #3a7de0; }
      #send-btn:disabled { background: #333; cursor: not-allowed; }

      #notice {
        font-size: 11px;
        color: #444;
        text-align: center;
        margin-top: 10px;
      }
    </style>
  </head>
  <body>

    <!-- ── Step 1: Enter API Key ── -->
    <div id="key-screen">
      <h2>🔑 Enter Your API Key</h2>
      <p>Your key is stored only in your browser's session memory.<br/>It is <strong>never saved, never sent anywhere</strong> except Google's API.</p>
      <input type="password" id="api-key-input" placeholder="Paste your Gemini API key..." />
      <button onclick="startChat()">Start Chatting</button>
      <div id="key-error">Please enter a valid API key.</div>
    </div>

    <!-- ── Step 2: Chat UI ── -->
    <div id="chat-screen">
      <div id="chat-header">
        <h2>🧑‍🏫 Father & Teacher AI</h2>
        <button id="reset-key-btn" onclick="resetKey()">Change API Key</button>
      </div>

      <div id="chat"></div>

      <div id="input-area">
        <input type="text" id="msg" placeholder="Ask something..." onkeydown="if(event.key==='Enter') send()" />
        <button id="send-btn" onclick="send()">Send</button>
      </div>
      <div id="notice">🔒 Your API key is only in memory — never stored on disk or GitHub.</div>
    </div>

    <script>
      // ── API key lives ONLY in memory (never localStorage, never hardcoded) ──
      let API_KEY = "";
      let messages = [];

      const persona =
        "You are a strict father and a teacher by profession. " +
        "You follow discipline and rules. Answer seriously like a father teaching his child. " +
        "Do not introduce yourself. The message is: ";

      function startChat() {
        const input = document.getElementById("api-key-input").value.trim();
        if (!input || input.length < 10) {
          document.getElementById("key-error").style.display = "block";
          return;
        }
        API_KEY = input;
        document.getElementById("key-screen").style.display = "none";
        document.getElementById("chat-screen").style.display = "flex";
        addBubble("ai", "Sit down. Pay attention. Ask your question.");
      }

      function resetKey() {
        API_KEY = "";
        messages = [];
        document.getElementById("chat").innerHTML = "";
        document.getElementById("api-key-input").value = "";
        document.getElementById("chat-screen").style.display = "none";
        document.getElementById("key-screen").style.display = "block";
      }

      function addBubble(type, text) {
        const chat = document.getElementById("chat");
        const div = document.createElement("div");
        div.className = "bubble " + type;
        div.textContent = text;
        chat.appendChild(div);
        chat.scrollTop = chat.scrollHeight;
        return div;
      }

      function showTyping() {
        const chat = document.getElementById("chat");
        const div = document.createElement("div");
        div.className = "typing";
        div.id = "typing-indicator";
        div.innerHTML = "<span></span><span></span><span></span>";
        chat.appendChild(div);
        chat.scrollTop = chat.scrollHeight;
      }

      function removeTyping() {
        const t = document.getElementById("typing-indicator");
        if (t) t.remove();
      }

      async function send() {
        const input = document.getElementById("msg");
        const btn = document.getElementById("send-btn");
        const userText = input.value.trim();
        if (!userText) return;

        input.value = "";
        btn.disabled = true;

        addBubble("user", userText);
        showTyping();

        try {
          const response = await fetch(
            `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${API_KEY}`,
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                contents: [{ parts: [{ text: persona + userText }] }]
              })
            }
          );

          removeTyping();

          if (!response.ok) {
            const err = await response.json();
            const msg = err?.error?.message || "API error. Check your key.";
            addBubble("ai error", "⚠️ " + msg);
            btn.disabled = false;
            return;
          }

          const data = await response.json();
          let aiText = "I could not generate a response.";
          if (data.candidates?.[0]?.content?.parts?.[0]?.text) {
            aiText = data.candidates[0].content.parts[0].text;
          }

          addBubble("ai", aiText);
        } catch (err) {
          removeTyping();
          addBubble("ai error", "⚠️ Network error. Please check your connection.");
        }

        btn.disabled = false;
      }
    </script>
  </body>
</html>
